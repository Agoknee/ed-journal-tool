{
  "name": "ed-journal-tool",
  "version": "0.2.0",
  "description": "Monitors Elite Dangerous journal files, stores them in SQLite and serves stats through an API and React dashboard.",
  "type": "module",
  "private": true,
  "main": "src/index.mjs",
  "bin": {
    "ed-journal-monitor": "src/index.mjs"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "test": "node --test test/",
    "lint": "node client/node_modules/oxlint/bin/oxlint -c .oxlintrc.json src test && npm run lint --prefix client",
    "start": "node src/index.mjs --dev-client",
    "start:built": "node src/index.mjs",
    "debug": "node src/index.mjs --debug --dev-client",
    "debug:built": "node src/index.mjs --debug",
    "client:install": "npm install --prefix client",
    "client:dev": "npm run dev --prefix client",
    "client:build": "npm run build --prefix client",
    "build": "npm run client:build",
    "dist": "npm run client:build && npm run dist:bundle && npm run dist:package",
    "dist:bundle": "node scripts/bundle-server.mjs",
    "dist:package": "node scripts/package-executables.mjs"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "express": "^5.3.0",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.25.0",
    "@yao-pkg/pkg-fetch": "^3.6.7",
    "esbuild": "^0.28.2",
    "resedit": "^3.1.1"
  },
  "pkg": {
    "assets": [
      "package.json",
      "packaging/edjt.ico",
      "client/dist/**/*"
    ],
    "targets": [
      "node26-linux-x64",
      "node26-win-x64"
    ]
  }
}
