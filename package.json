{
  "name": "ed-journal-tool",
  "version": "1.0.0",
  "description": "Monitors Elite Dangerous journal files, stores them in SQLite and serves stats through an API and React dashboard.",
  "type": "module",
  "private": true,
  "main": "src/index.mjs",
  "bin": {
    "ed-journal-monitor": "src/index.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node src/index.mjs",
    "debug": "node src/index.mjs --debug",
    "client:install": "npm install --prefix client",
    "client:dev": "npm run dev --prefix client",
    "client:build": "npm run build --prefix client",
    "build": "npm run client:build"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "express": "^5.3.0",
    "yargs": "^18.2.0"
  }
}
